# ---------------------------------------------------------------------------
# Employee Service Portal — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
#
# Obtain GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from Google Cloud Console.
# See README.md → "Google Cloud Console Setup" for step-by-step instructions.
# ---------------------------------------------------------------------------

# Google OAuth 2.0 client credentials (Web application type)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Random secret used by Auth.js (NextAuth) to sign sessions / JWTs.
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-string

# Base URL of the application (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3000

# The Google Workspace domain that is allowed to sign in.
# Only users whose email ends with `@<this domain>` will be granted access.
ALLOWED_WORKSPACE_DOMAIN=yourcompany.com
